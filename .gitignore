# ============================================================
# Jamia Abdullah Bin Mubarak Portal — .gitignore
# ============================================================

# ── Node / npm ──────────────────────────────────────────────
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions
.pnp
.pnp.*

# ── Next.js ─────────────────────────────────────────────────
.next/
out/
build/
/coverage

# ── TypeScript ───────────────────────────────────────────────
*.tsbuildinfo
next-env.d.ts

# ── Environment / Secrets (NEVER commit these) ───────────────
.env
.env.local
.env.development
.env.development.local
.env.test
.env.test.local
.env.production
.env.production.local
.env.*
!.env.example

# ── Firebase Private Credentials ────────────────────────────
*serviceAccount*.json
*service-account*.json
firebase-adminsdk*.json
*.firebase.json
.firebaserc
firebase-debug.log

# ── Private keys / credentials ───────────────────────────────
*.pem
*.key
*.p12
*.pfx
*credentials*.json
*secrets*.json

# ── OS generated ────────────────────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
desktop.ini

# ── IDE / Editor ─────────────────────────────────────────────
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# ── Logs ─────────────────────────────────────────────────────
logs/
*.log

# ── Testing / temp ───────────────────────────────────────────
/tmp/
*.tmp

# ── Deployment platforms ─────────────────────────────────────
.vercel

# ── Local scripts (may contain credentials) ──────────────────
dopush.bat
*.bat
