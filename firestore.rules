rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ── PUBLIC READ COLLECTIONS ─────────────────────────────────────────
    // Anyone (including unauthenticated visitors) can read these.

    match /site_settings/{docId} {
      allow read: if true;
      allow write: if request.auth != null && isAdmin();
    }

    match /departments/{docId} {
      allow read: if true;
      allow write: if request.auth != null && isAdmin();
    }

    match /courses/{docId} {
      allow read: if true;
      allow write: if request.auth != null && isAdmin();
    }

    match /news/{docId} {
      allow read: if true;
      allow write: if request.auth != null && isAdmin();
    }

    match /events/{docId} {
      allow read: if true;
      allow write: if request.auth != null && isAdmin();
    }

    match /gallery/{docId} {
      allow read: if true;
      allow write: if request.auth != null && isAdmin();
    }

    match /teachers/{docId} {
      allow read: if true;
      allow write: if request.auth != null && isAdmin();
    }

    match /staff/{docId} {
      allow read: if true;
      allow write: if request.auth != null && isAdmin();
    }

    // ── PROTECTED COLLECTIONS ───────────────────────────────────────────

    match /users/{userId} {
      // Users can read their own doc; admins can read all
      allow read: if request.auth != null &&
        (request.auth.uid == userId || isAdmin());
      allow create: if request.auth != null;
      allow update: if request.auth != null &&
        (request.auth.uid == userId || isAdmin());
      allow delete: if request.auth != null && isAdmin();
    }

    match /admissions/{docId} {
      // Anyone can submit an application; only admins can read/update
      allow create: if true;
      allow read, update, delete: if request.auth != null && isAdmin();
    }

    match /attendance/{docId} {
      allow read, write: if request.auth != null && isAdmin();
    }

    match /finance/{docId} {
      allow read, write: if request.auth != null && isAdmin();
    }

    match /donations/{docId} {
      allow read: if true;
      allow write: if request.auth != null && isAdmin();
    }

    // ── HELPER FUNCTION ─────────────────────────────────────────────────
    function isAdmin() {
      return request.auth != null &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in
          ['admin', 'super_admin'];
    }
  }
}
